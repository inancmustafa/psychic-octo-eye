<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Usage Widget" Width="420" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#BBC6D8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3B475A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Surface" Background="#151A23" BorderBrush="#3A4658" BorderThickness="1" CornerRadius="20" Margin="6" Padding="14,10,14,12">
  <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
  <StackPanel>
   <Grid x:Name="DragArea" Background="Transparent" Height="30" ToolTip="Taşımak için sürükle; ayrıntılar için üzerine gel.">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="6" Height="6" Fill="#D8AD8F" Margin="0,0,6,0"/>
     <TextBlock Text="Claude" Foreground="#DCE2EB" FontSize="11" VerticalAlignment="Center"/>
     <TextBlock x:Name="MiniClaude" Text="—" Foreground="#D8AD8F" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
     <Border Width="1" Height="13" Background="#3A4658" Margin="12,0"/>
     <Ellipse Width="6" Height="6" Fill="#85C9B7" Margin="0,0,6,0"/>
     <TextBlock Text="Codex" Foreground="#DCE2EB" FontSize="11" VerticalAlignment="Center"/>
     <TextBlock x:Name="MiniCodex" Text="—" Foreground="#85C9B7" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <Button x:Name="PinButton" Grid.Column="1" Content="◇" FontSize="15" ToolTip="Ayrıntıları açık tut" AutomationProperties.Name="Ayrıntıları sabitle"/>
    <Button x:Name="CloseButton" Grid.Column="2" Content="×" FontSize="18" ToolTip="Kapat" AutomationProperties.Name="Kapat"/>
   </Grid>
   <StackPanel x:Name="Details">
    <Grid Margin="2,13,2,12"><TextBlock Text="KULLANIM KOTALARI" FontSize="10" FontWeight="SemiBold" Foreground="#95A2B6"/><TextBlock Text="HESAP GENELİ" HorizontalAlignment="Right" FontSize="9" Foreground="#74839A"/></Grid>
    <StackPanel x:Name="CardHost"/>
    <DockPanel Margin="2,1,2,0"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻  Yenile" Padding="9,5" FontSize="11"/><Button x:Name="HelpButton" DockPanel.Dock="Right" Content="?" Padding="9,5" FontSize="12" ToolTip="Kullanım kılavuzu"/><TextBlock Text="5 dakikada bir güncellenir" Foreground="#95A2B6" FontSize="10" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="Footer" Text="Bağlantı hazırlanıyor…" Foreground="#74839A" FontSize="10" TextWrapping="Wrap" Margin="3,7,3,0"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>