<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#1C222D" BorderBrush="#303947" BorderThickness="1" CornerRadius="17" Padding="16" Margin="0,0,0,10">
 <StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Width="80" Height="80" VerticalAlignment="Top">
    <Ellipse Width="70" Height="70" Stroke="#303947" StrokeThickness="5"/>
    <Path x:Name="Arc" Stroke="$Color" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock x:Name="Value" Text="—" Foreground="#F7F8FC" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="RingLabel" Text="bekliyor" Foreground="#96A2B6" FontSize="10" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Column="1" Margin="15,3,0,0">
    <DockPanel><TextBlock Text="$Title" FontSize="18" FontWeight="SemiBold" Foreground="#F7F8FC"/><TextBlock x:Name="Status" Text="BAĞLANIYOR" FontSize="9" Foreground="$Color" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="Message" Text="Kullanım bilgisi alınıyor…" Foreground="#A8B3C6" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <Button x:Name="Connect" Content="Hesabı bağla ↗" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" FontSize="11" Cursor="Hand" Foreground="#F7F8FC" Background="#313C4D" BorderThickness="0"/>
   </StackPanel>
  </Grid>
  <StackPanel x:Name="Quotas" Margin="0,11,0,0"/>
 </StackPanel>
</Border>